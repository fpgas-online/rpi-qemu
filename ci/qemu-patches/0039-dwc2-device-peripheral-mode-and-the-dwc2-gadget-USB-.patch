Claude-Session: https://claude.ai/code/session_01MSxgFokyz65AL7GTVbUaZS
---
 hw/usb/dwc2-gadget.c | 1040 ++++++++++++++++++++++++++++++++++++++++++
 hw/usb/hcd-dwc2.c    |  125 ++++-
 hw/usb/hcd-dwc2.h    |   67 +++
 hw/usb/meson.build   |    2 +-
 hw/usb/trace-events  |   10 +
 5 files changed, 1219 insertions(+), 25 deletions(-)
 create mode 100644 hw/usb/dwc2-gadget.c

diff --git a/hw/usb/dwc2-gadget.c b/hw/usb/dwc2-gadget.c
new file mode 100644
index 0000000..9c922de
--- /dev/null
+++ b/hw/usb/dwc2-gadget.c
@@ -0,0 +1,1040 @@
+/*
+ * dwc-hsotg (dwc2) USB OTG controller: device (peripheral) mode
+ *
+ * The guest drives the controller's device registers exactly as on
+ * silicon (buffer DMA, the mode the BCM2835's core supports and the stock
+ * Linux dwc2 driver uses); the "dwc2-gadget" USB device presents what it
+ * does to a QEMU USB host controller, e.g. usbip-server:
+ *
+ *   -device usbip-server,id=usbip0,chardev=... -device dwc2-gadget,bus=usbip0.0
+ *
+ * Host packets wait (USB_RET_ASYNC) until the guest arms the endpoint, as
+ * a real host's transactions are NAKed; data moves by DMA packet by packet
+ * with the core's XferSize/PktCnt accounting, so short packets, zero
+ * length packets and transfers spanning several host or device buffers
+ * end exactly where they would on the wire.
+ *
+ * Copyright (c) 2026 Tim 'mithro' Ansell <me@mith.ro>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"
+#include "qemu/error-report.h"
+#include "qemu/iov.h"
+#include "qemu/log.h"
+#include "qemu/main-loop.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/usb/dwc2-regs.h"
+#include "hw/usb/usb.h"
+#include "migration/vmstate.h"
+#include "hcd-dwc2.h"
+#include "trace.h"
+
+#define TYPE_DWC2_GADGET "dwc2-gadget"
+OBJECT_DECLARE_SIMPLE_TYPE(DWC2GadgetState, DWC2_GADGET)
+
+typedef enum DWC2CtrlPhase {
+    DWC2_CTRL_IDLE,
+    DWC2_CTRL_SETUP,            /* SETUP waiting for EP0 OUT to be armed */
+    DWC2_CTRL_DATA_IN,
+    DWC2_CTRL_DATA_OUT,
+    DWC2_CTRL_STATUS_IN,
+    DWC2_CTRL_STATUS_OUT,
+} DWC2CtrlPhase;
+
+struct DWC2GadgetState {
+    USBDevice parent_obj;
+
+    DWC2State *dwc2;
+    QEMUBH *connect_bh;
+
+    /* Bus reset signalling (T_DRST) and reset recovery (T_RSTRCY) */
+    QEMUTimer *reset_timer;
+    int reset_phase;
+
+    /* The host's control transfer on EP0 */
+    USBPacket *ctrl_p;
+    DWC2CtrlPhase ctrl_phase;
+    uint32_t ctrl_len;
+    uint32_t ctrl_done;
+
+    /* The host's packet on each data endpoint, per direction */
+    USBPacket *in_p[DWC2_NB_EP];
+    USBPacket *out_p[DWC2_NB_EP];
+    uint32_t out_off[DWC2_NB_EP];
+};
+
+/* Per-endpoint register block: DxEPCTL, -, DxEPINT, -, DxEPTSIZ, DxEPDMA */
+enum {
+    DEP_CTL = 0,
+    DEP_INT = 2,
+    DEP_TSIZ = 4,
+    DEP_DMA = 5,
+    DEP_TXFSTS = 6,
+    DEP_DMAB = 7,
+};
+
+static uint32_t *dwc2_ep(DWC2State *s, int n, bool in)
+{
+    return in ? s->iepreg[n] : s->oepreg[n];
+}
+
+/* Role, session and connection */
+
+static bool dwc2_cable_is_device(DWC2State *s)
+{
+    return s->otg_cable == DWC2_CABLE_DEVICE ||
+           (s->otg_cable == DWC2_CABLE_AUTO && s->gadget);
+}
+
+bool dwc2_is_host_role(DWC2State *s)
+{
+    if (s->gusbcfg & GUSBCFG_FORCEHOSTMODE) {
+        return true;
+    }
+    if (s->gusbcfg & GUSBCFG_FORCEDEVMODE) {
+        return false;
+    }
+    return !(s->gotgctl & GOTGCTL_CONID_B);
+}
+
+static bool dwc2_vbus(DWC2State *s)
+{
+    USBDevice *dev = s->gadget ? USB_DEVICE(s->gadget) : NULL;
+
+    return dev && dev->port && usb_port_vbus(dev->port);
+}
+
+/*
+ * The OTG connector: with a B-plug (ID floating) the controller is a
+ * peripheral and the session follows the host's VBUS; with an A-plug (ID
+ * grounded) it is the host and powers VBUS itself.
+ */
+static void dwc2_session_apply(DWC2State *s, bool events)
+{
+    uint32_t old = s->gotgctl;
+
+    s->gotgctl &= ~(GOTGCTL_CONID_B | GOTGCTL_ASESVLD | GOTGCTL_BSESVLD);
+    if (!dwc2_cable_is_device(s)) {
+        s->gotgctl |= GOTGCTL_ASESVLD | GOTGCTL_BSESVLD;
+    } else {
+        s->gotgctl |= GOTGCTL_CONID_B;
+        if (dwc2_vbus(s)) {
+            s->gotgctl |= GOTGCTL_ASESVLD | GOTGCTL_BSESVLD;
+        }
+    }
+
+    if (events) {
+        if ((old ^ s->gotgctl) & GOTGCTL_CONID_B) {
+            dwc2_set_gintsts(s, GINTSTS_CONIDSTSCHNG, true);
+        }
+        if (!(old & GOTGCTL_BSESVLD) && (s->gotgctl & GOTGCTL_BSESVLD)) {
+            dwc2_set_gintsts(s, GINTSTS_SESSREQINT, true);
+        } else if ((old & GOTGCTL_BSESVLD) &&
+                   !(s->gotgctl & GOTGCTL_BSESVLD)) {
+            s->gotgint |= GOTGINT_SES_END_DET;
+            dwc2_set_gintsts(s, GINTSTS_OTGINT, true);
+            /* no host, no bus traffic: the core is suspended */
+            s->dsts |= DSTS_SUSPSTS;
+        }
+    }
+    dwc2_device_update_connection(s);
+}
+
+void dwc2_device_update_session(DWC2State *s)
+{
+    dwc2_session_apply(s, true);
+}
+
+/*
+ * The host sees the device while the controller is a peripheral with a
+ * valid session and the pull-up connected (DCTL.SftDiscon clear).
+ */
+static bool dwc2_pullup_visible(DWC2State *s)
+{
+    return s->gadget && !dwc2_is_host_role(s) &&
+           (s->gotgctl & GOTGCTL_BSESVLD) && !(s->dctl & DCTL_SFTDISCON);
+}
+
+void dwc2_device_update_connection(DWC2State *s)
+{
+    if (s->gadget) {
+        qemu_bh_schedule(s->gadget->connect_bh);
+    }
+}
+
+static void dwc2_gadget_connect_bh(void *opaque)
+{
+    DWC2GadgetState *g = opaque;
+    USBDevice *dev = USB_DEVICE(g);
+    DWC2State *s = g->dwc2;
+    bool want = s && s->gadget == g && dwc2_pullup_visible(s);
+    Error *err = NULL;
+
+    if (want == dev->attached || !dev->port) {
+        return;
+    }
+    trace_usb_dwc2_gadget_connect(want);
+    if (want) {
+        dev->speedmask = USB_SPEED_MASK_FULL;
+        if (get_field(s->dcfg, DCFG_DEVSPD) == DCFG_DEVSPD_HS) {
+            dev->speedmask |= USB_SPEED_MASK_HIGH;
+        }
+        usb_device_attach(dev, &err);
+        if (err) {
+            warn_report_err(err);
+        }
+    } else {
+        usb_device_detach(dev);
+    }
+}
+
+/* Interrupts */
+
+void dwc2_device_update_irq(DWC2State *s)
+{
+    uint32_t daint = 0;
+    int n;
+
+    for (n = 0; n < DWC2_NB_EP; n++) {
+        uint32_t imsk = s->diepmsk;
+
+        if ((s->diepempmsk >> n) & 1) {
+            imsk |= DXEPINT_TXFEMP;
+        }
+        if (s->iepreg[n][DEP_INT] & imsk) {
+            daint |= 1 << n;
+        }
+        if (s->oepreg[n][DEP_INT] & s->doepmsk) {
+            daint |= 1 << (16 + n);
+        }
+    }
+    s->daint = daint;
+    dwc2_set_gintsts(s, GINTSTS_IEPINT, daint & s->daintmsk & 0x0000ffff);
+    dwc2_set_gintsts(s, GINTSTS_OEPINT, daint & s->daintmsk & 0xffff0000);
+}
+
+/* Endpoint transfer accounting (DxEPTSIZ) */
+
+static uint32_t dwc2_ep_mps(DWC2State *s, int n, bool in)
+{
+    static const uint32_t ep0_mps[] = { 64, 32, 16, 8 };
+    uint32_t ctl = dwc2_ep(s, n, in)[DEP_CTL];
+
+    if (n == 0) {
+        return ep0_mps[ctl & D0EPCTL_MPS_MASK];
+    }
+    return ctl & DXEPCTL_MPS_MASK;
+}
+
+static void dwc2_tsiz_get(DWC2State *s, int n, bool in,
+                          uint32_t *xfer, uint32_t *pkt)
+{
+    uint32_t tsiz = dwc2_ep(s, n, in)[DEP_TSIZ];
+
+    if (n == 0) {
+        *xfer = tsiz & 0x7f;
+        *pkt = (tsiz >> 19) & (in ? 3 : 1);
+    } else {
+        *xfer = DXEPTSIZ_XFERSIZE_GET(tsiz);
+        *pkt = DXEPTSIZ_PKTCNT_GET(tsiz);
+    }
+}
+
+static void dwc2_tsiz_set(DWC2State *s, int n, bool in,
+                          uint32_t xfer, uint32_t pkt)
+{
+    uint32_t *tsiz = &dwc2_ep(s, n, in)[DEP_TSIZ];
+    uint32_t xmask = n ? DXEPTSIZ_XFERSIZE_MASK : 0x7f;
+    uint32_t pmask = n ? 0x3ff : (in ? 3 : 1);
+
+    *tsiz &= ~(xmask | (pmask << 19));
+    *tsiz |= (xfer & xmask) | ((pkt & pmask) << 19);
+}
+
+/* The programmed transfer is complete: the core disables the endpoint. */
+static void dwc2_ep_xfer_done(DWC2State *s, int n, bool in)
+{
+    uint32_t *ep = dwc2_ep(s, n, in);
+
+    ep[DEP_CTL] &= ~DXEPCTL_EPENA;
+    if (!in) {
+        ep[DEP_CTL] |= DXEPCTL_NAKSTS;  /* NAK further OUT until re-armed */
+    }
+    ep[DEP_INT] |= DXEPINT_XFERCOMPL;
+    trace_usb_dwc2_gadget_xfercompl(n, in);
+}
+
+static bool dwc2_ep_dma(DWC2State *s, int n, bool in, void *buf,
+                        uint32_t len)
+{
+    uint32_t *ep = dwc2_ep(s, n, in);
+    MemTxResult r;
+
+    if (!len) {
+        return true;            /* zero-length packet */
+    }
+    if (in) {
+        r = dma_memory_read(&s->dma_as, ep[DEP_DMA], buf, len,
+                            MEMTXATTRS_UNSPECIFIED);
+    } else {
+        r = dma_memory_write(&s->dma_as, ep[DEP_DMA], buf, len,
+                             MEMTXATTRS_UNSPECIFIED);
+    }
+    if (r != MEMTX_OK) {
+        qemu_log_mask(LOG_GUEST_ERROR, "dwc2: EP%d %s DMA to 0x%08x failed\n",
+                      n, in ? "IN" : "OUT", ep[DEP_DMA]);
+        ep[DEP_CTL] &= ~DXEPCTL_EPENA;
+        ep[DEP_INT] |= DXEPINT_AHBERR;
+        return false;
+    }
+    ep[DEP_DMA] += len;
+    return true;
+}
+
+/*
+ * IN: move packets from the guest's armed transfer into @buf (room @room).
+ * Returns the bytes moved; *host_done is set when the host's transfer
+ * ends (a short packet, or its buffer is full), *babble if the device
+ * sent more than the host asked for.
+ */
+static uint32_t dwc2_ep_in_packets(DWC2State *s, int n, uint8_t *buf,
+                                   uint32_t room, bool *host_done,
+                                   bool *babble)
+{
+    uint32_t *ep = dwc2_ep(s, n, true);
+    uint32_t mps = dwc2_ep_mps(s, n, true);
+    uint32_t xfer, pkt, moved = 0;
+
+    *host_done = false;
+    *babble = false;
+    if (!(ep[DEP_CTL] & DXEPCTL_EPENA) || (ep[DEP_CTL] & DXEPCTL_NAKSTS) ||
+        (n > 0 && (s->dctl & DCTL_GNPINNAKSTS))) {
+        return 0;
+    }
+    dwc2_tsiz_get(s, n, true, &xfer, &pkt);
+    while (pkt > 0) {
+        uint32_t chunk = MIN(mps, xfer);
+
+        if (chunk > room - moved) {
+            *babble = true;
+            *host_done = true;
+            break;
+        }
+        if (!dwc2_ep_dma(s, n, true, buf + moved, chunk)) {
+            return moved;
+        }
+        moved += chunk;
+        xfer -= chunk;
+        pkt--;
+        if (chunk < mps || moved == room) {
+            *host_done = true;
+            break;
+        }
+    }
+    dwc2_tsiz_set(s, n, true, xfer, pkt);
+    if (pkt == 0) {
+        dwc2_ep_xfer_done(s, n, true);
+    }
+    return moved;
+}
+
+/*
+ * OUT: move packets of @data (@len bytes, from @off) into the guest's armed
+ * transfer.  Returns the bytes moved; *host_done is set when all of the
+ * host's data has been delivered.
+ */
+static uint32_t dwc2_ep_out_packets(DWC2State *s, int n, const uint8_t *data,
+                                    uint32_t len, uint32_t off,
+                                    bool *host_done)
+{
+    uint32_t *ep = dwc2_ep(s, n, false);
+    uint32_t mps = dwc2_ep_mps(s, n, false);
+    uint32_t xfer, pkt, moved = 0;
+    bool short_pkt = false;
+
+    *host_done = false;
+    if (!(ep[DEP_CTL] & DXEPCTL_EPENA) || (ep[DEP_CTL] & DXEPCTL_NAKSTS) ||
+        (s->dctl & DCTL_GOUTNAKSTS)) {
+        return 0;
+    }
+    dwc2_tsiz_get(s, n, false, &xfer, &pkt);
+    while (pkt > 0) {
+        uint32_t chunk = MIN(mps, len - off - moved);
+
+        if (chunk > xfer) {
+            qemu_log_mask(LOG_GUEST_ERROR,
+                          "dwc2: EP%d OUT packet of %u bytes overflows the "
+                          "%u left in the transfer\n", n, chunk, xfer);
+            chunk = xfer;
+        }
+        if (!dwc2_ep_dma(s, n, false, (uint8_t *)data + off + moved, chunk)) {
+            return moved;
+        }
+        moved += chunk;
+        xfer -= chunk;
+        pkt--;
+        if (chunk < mps) {
+            short_pkt = true;
+        }
+        if (short_pkt || off + moved == len) {
+            *host_done = off + moved == len;
+            break;
+        }
+    }
+    dwc2_tsiz_set(s, n, false, xfer, pkt);
+    if (pkt == 0 || short_pkt) {
+        dwc2_ep_xfer_done(s, n, false);
+    }
+    return moved;
+}
+
+/* Control transfers on EP0 */
+
+static void dwc2_ctrl_complete(DWC2GadgetState *g, int status)
+{
+    USBPacket *p = g->ctrl_p;
+
+    trace_usb_dwc2_gadget_ctrl_complete(status, g->ctrl_done);
+    g->ctrl_p = NULL;
+    g->ctrl_phase = DWC2_CTRL_IDLE;
+    p->status = status;
+    p->actual_length = g->ctrl_done;
+    usb_generic_async_ctrl_complete(USB_DEVICE(g), p);
+}
+
+static void dwc2_ep0_run(DWC2GadgetState *g)
+{
+    DWC2State *s = g->dwc2;
+    USBDevice *dev = USB_DEVICE(g);
+    uint32_t *in0 = s->iepreg[0], *out0 = s->oepreg[0];
+    bool done;
+
+    if (!g->ctrl_p) {
+        return;
+    }
+
+    /* A stall answers whatever stage the host is in. */
+    if (g->ctrl_phase != DWC2_CTRL_SETUP &&
+        ((in0[DEP_CTL] | out0[DEP_CTL]) & DXEPCTL_STALL)) {
+        dwc2_ctrl_complete(g, USB_RET_STALL);
+        return;
+    }
+
+    switch (g->ctrl_phase) {
+    case DWC2_CTRL_SETUP: {
+        uint32_t xfer, pkt, supcnt;
+
+        /* no SETUP during a bus reset or its recovery time */
+        if (g->reset_phase) {
+            return;
+        }
+        if (!(out0[DEP_CTL] & DXEPCTL_EPENA)) {
+            return;
+        }
+        if (!dwc2_ep_dma(s, 0, false, dev->setup_buf, 8)) {
+            dwc2_ctrl_complete(g, USB_RET_IOERROR);
+            return;
+        }
+        dwc2_tsiz_get(s, 0, false, &xfer, &pkt);
+        supcnt = get_field(out0[DEP_TSIZ], DOEPTSIZ0_SUPCNT);
+        dwc2_tsiz_set(s, 0, false, xfer > 8 ? xfer - 8 : 0,
+                      pkt ? pkt - 1 : 0);
+        set_field(&out0[DEP_TSIZ], supcnt ? supcnt - 1 : 0, DOEPTSIZ0_SUPCNT);
+        /* a SETUP clears a stall and NAKs both directions of EP0 */
+        out0[DEP_CTL] &= ~(DXEPCTL_EPENA | DXEPCTL_STALL);
+        in0[DEP_CTL] &= ~DXEPCTL_STALL;
+        out0[DEP_CTL] |= DXEPCTL_NAKSTS;
+        in0[DEP_CTL] |= DXEPCTL_NAKSTS;
+        out0[DEP_INT] |= DXEPINT_SETUP;
+        trace_usb_dwc2_gadget_setup(ldq_le_p(dev->setup_buf));
+        if (g->ctrl_len == 0) {
+            g->ctrl_phase = DWC2_CTRL_STATUS_IN;
+        } else if (dev->setup_buf[0] & USB_DIR_IN) {
+            g->ctrl_phase = DWC2_CTRL_DATA_IN;
+        } else {
+            g->ctrl_phase = DWC2_CTRL_DATA_OUT;
+        }
+        break;
+    }
+    case DWC2_CTRL_DATA_IN: {
+        bool babble;
+
+        g->ctrl_done += dwc2_ep_in_packets(s, 0, dev->data_buf + g->ctrl_done,
+                                           g->ctrl_len - g->ctrl_done,
+                                           &done, &babble);
+        if (babble) {
+            dwc2_ctrl_complete(g, USB_RET_BABBLE);
+        } else if (done) {
+            g->ctrl_phase = DWC2_CTRL_STATUS_OUT;
+        }
+        break;
+    }
+    case DWC2_CTRL_DATA_OUT:
+        g->ctrl_done += dwc2_ep_out_packets(s, 0, dev->data_buf, g->ctrl_len,
+                                            g->ctrl_done, &done);
+        if (done) {
+            g->ctrl_phase = DWC2_CTRL_STATUS_IN;
+        }
+        break;
+    case DWC2_CTRL_STATUS_IN: {
+        bool babble;
+
+        dwc2_ep_in_packets(s, 0, NULL, 0, &done, &babble);
+        if (done) {
+            dwc2_ctrl_complete(g, babble ? USB_RET_BABBLE : USB_RET_SUCCESS);
+        }
+        break;
+    }
+    case DWC2_CTRL_STATUS_OUT:
+        dwc2_ep_out_packets(s, 0, NULL, 0, 0, &done);
+        if (done) {
+            dwc2_ctrl_complete(g, USB_RET_SUCCESS);
+        }
+        break;
+    case DWC2_CTRL_IDLE:
+        break;
+    }
+}
+
+/* Data endpoints */
+
+/*
+ * Returns true if the host's packet on endpoint @n is finished (its status
+ * set); the caller completes it.
+ */
+static bool dwc2_ep_in_run(DWC2GadgetState *g, int n)
+{
+    DWC2State *s = g->dwc2;
+    USBPacket *p = g->in_p[n];
+    uint32_t *ep = s->iepreg[n];
+    g_autofree uint8_t *buf = NULL;
+    uint32_t room, moved;
+    bool done, babble;
+
+    if (ep[DEP_CTL] & DXEPCTL_STALL) {
+        p->status = USB_RET_STALL;
+        return true;
+    }
+    room = p->iov.size - p->actual_length;
+    buf = g_malloc(MAX(room, 1));
+    moved = dwc2_ep_in_packets(s, n, buf, room, &done, &babble);
+    usb_packet_copy(p, buf, moved);
+    if (babble) {
+        p->status = USB_RET_BABBLE;
+    }
+    return done;
+}
+
+static bool dwc2_ep_out_run(DWC2GadgetState *g, int n)
+{
+    DWC2State *s = g->dwc2;
+    USBPacket *p = g->out_p[n];
+    g_autofree uint8_t *data = NULL;
+    size_t len = p->iov.size;
+    bool done;
+
+    if (s->oepreg[n][DEP_CTL] & DXEPCTL_STALL) {
+        p->status = USB_RET_STALL;
+        return true;
+    }
+    data = g_malloc(MAX(len, 1));
+    iov_to_buf(p->iov.iov, p->iov.niov, 0, data, len);
+    g->out_off[n] += dwc2_ep_out_packets(s, n, data, len, g->out_off[n],
+                                         &done);
+    if (done) {
+        p->actual_length = len;
+    }
+    return done;
+}
+
+/* An asynchronous host packet the endpoint has finished. */
+static void dwc2_gadget_packet_done(USBDevice *dev, USBPacket *p)
+{
+    if (p->status == USB_RET_ASYNC) {
+        p->status = USB_RET_SUCCESS;
+    }
+    usb_packet_complete(dev, p);
+}
+
+/* Run every transfer the guest's endpoint programming allows. */
+void dwc2_device_run(DWC2State *s)
+{
+    DWC2GadgetState *g = s->gadget;
+    USBDevice *dev;
+    int n;
+
+    if (!g || dwc2_is_host_role(s)) {
+        return;
+    }
+    dev = USB_DEVICE(g);
+    dwc2_ep0_run(g);
+    for (n = 1; n < DWC2_NB_EP; n++) {
+        if (g->in_p[n] && dwc2_ep_in_run(g, n)) {
+            USBPacket *p = g->in_p[n];
+
+            g->in_p[n] = NULL;
+            dwc2_gadget_packet_done(dev, p);
+        }
+        if (g->out_p[n] && dwc2_ep_out_run(g, n)) {
+            USBPacket *p = g->out_p[n];
+
+            g->out_p[n] = NULL;
+            dwc2_gadget_packet_done(dev, p);
+        }
+    }
+    dwc2_device_update_irq(s);
+}
+
+/* Device registers (0x800-0xdff) */
+
+static uint32_t dwc2_dsts(DWC2State *s)
+{
+    /* SOF frame number, counting (micro)frames of the enumerated speed */
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    int64_t frame = get_field(s->dsts, DSTS_ENUMSPD) == DSTS_ENUMSPD_HS ?
+                    now / 125000 : now / 1000000;
+
+    return (s->dsts & ~DSTS_SOFFN_MASK) |
+           ((frame << DSTS_SOFFN_SHIFT) & DSTS_SOFFN_MASK);
+}
+
+uint64_t dwc2_dreg_read(DWC2State *s, hwaddr addr)
+{
+    uint32_t val = 0;
+
+    if (addr >= DCFG && addr < DCFG + DWC2_DREG_SIZE) {
+        val = addr == DSTS ? dwc2_dsts(s) : s->dreg[(addr - DCFG) >> 2];
+    } else if (addr >= DIEPCTL(0) && addr < DIEPCTL(DWC2_EP_BLOCKS)) {
+        int n = (addr - DIEPCTL(0)) >> 5;
+        val = n < DWC2_NB_EP ? s->iepreg[n][(addr >> 2) & 7] : 0;
+    } else if (addr >= DOEPCTL(0) && addr < DOEPCTL(DWC2_EP_BLOCKS)) {
+        int n = (addr - DOEPCTL(0)) >> 5;
+        val = n < DWC2_NB_EP ? s->oepreg[n][(addr >> 2) & 7] : 0;
+    }
+    trace_usb_dwc2_dreg_read(addr, val);
+    return val;
+}
+
+static void dwc2_epctl_write(DWC2State *s, int n, bool in, uint32_t val)
+{
+    uint32_t *ctl = &dwc2_ep(s, n, in)[DEP_CTL];
+    uint32_t old = *ctl, v;
+    uint32_t rw;
+
+    if (n == 0) {
+        /* EP0: always active control endpoint; the core clears STALL */
+        rw = D0EPCTL_MPS_MASK | (in ? DXEPCTL_TXFNUM_MASK : 0);
+        v = (old & ~rw) | (val & rw) | DXEPCTL_USBACTEP |
+            (val & DXEPCTL_STALL);
+    } else {
+        rw = DXEPCTL_MPS_MASK | DXEPCTL_USBACTEP | DXEPCTL_EPTYPE_MASK |
+             DXEPCTL_SNP | DXEPCTL_STALL | DXEPCTL_TXFNUM_MASK;
+        v = (old & ~rw) | (val & rw);
+        if (val & DXEPCTL_SETD0PID) {
+            v &= ~DXEPCTL_DPID;
+        }
+        if (val & DXEPCTL_SETD1PID) {
+            v |= DXEPCTL_DPID;
+        }
+    }
+    if (n > 0 && s->gadget) {
+        /* the endpoint as the host sees it: active, with its type */
+        static const uint8_t type[] = {
+            USB_ENDPOINT_XFER_CONTROL, USB_ENDPOINT_XFER_ISOC,
+            USB_ENDPOINT_XFER_BULK, USB_ENDPOINT_XFER_INT,
+        };
+
+        usb_ep_set_type(USB_DEVICE(s->gadget),
+                        in ? USB_TOKEN_IN : USB_TOKEN_OUT, n,
+                        v & DXEPCTL_USBACTEP ?
+                        type[(v & DXEPCTL_EPTYPE_MASK) >> 18] :
+                        USB_ENDPOINT_XFER_INVALID);
+    }
+    if (val & DXEPCTL_SNAK) {
+        v |= DXEPCTL_NAKSTS;
+        if (in) {
+            /* the core NAKs the next IN token at once: NAK effective */
+            dwc2_ep(s, n, true)[DEP_INT] |= DXEPINT_INEPNAKEFF;
+        }
+    }
+    if (val & DXEPCTL_CNAK) {
+        v &= ~DXEPCTL_NAKSTS;
+    }
+    if ((val & DXEPCTL_EPDIS) && (old & DXEPCTL_EPENA)) {
+        v &= ~DXEPCTL_EPENA;
+        dwc2_ep(s, n, in)[DEP_INT] |= DXEPINT_EPDISBLD;
+    } else if (val & DXEPCTL_EPENA) {
+        v |= DXEPCTL_EPENA;
+    }
+    *ctl = v;
+}
+
+static void dwc2_dctl_write(DWC2State *s, uint32_t val)
+{
+    uint32_t old = s->dctl;
+    uint32_t v = (val & ~(DCTL_SGNPINNAK | DCTL_CGNPINNAK | DCTL_SGOUTNAK |
+                          DCTL_CGOUTNAK | DCTL_GNPINNAKSTS | DCTL_GOUTNAKSTS)) |
+                 (old & (DCTL_GNPINNAKSTS | DCTL_GOUTNAKSTS));
+
+    if (val & DCTL_SGNPINNAK) {
+        v |= DCTL_GNPINNAKSTS;
+        dwc2_set_gintsts(s, GINTSTS_GINNAKEFF, true);
+    }
+    if (val & DCTL_CGNPINNAK) {
+        v &= ~DCTL_GNPINNAKSTS;
+        dwc2_set_gintsts(s, GINTSTS_GINNAKEFF, false);
+    }
+    if (val & DCTL_SGOUTNAK) {
+        v |= DCTL_GOUTNAKSTS;
+        dwc2_set_gintsts(s, GINTSTS_GOUTNAKEFF, true);
+    }
+    if (val & DCTL_CGOUTNAK) {
+        v &= ~DCTL_GOUTNAKSTS;
+        dwc2_set_gintsts(s, GINTSTS_GOUTNAKEFF, false);
+    }
+    s->dctl = v;
+    if ((old ^ v) & DCTL_SFTDISCON) {
+        dwc2_device_update_connection(s);
+    }
+}
+
+void dwc2_dreg_write(DWC2State *s, hwaddr addr, uint64_t val64)
+{
+    uint32_t val = val64;
+
+    trace_usb_dwc2_dreg_write(addr, val);
+    if (addr >= DCFG && addr < DCFG + DWC2_DREG_SIZE) {
+        switch (addr) {
+        case DCTL:
+            dwc2_dctl_write(s, val);
+            break;
+        case DSTS:
+        case DAINT:
+            break;              /* read-only */
+        default:
+            s->dreg[(addr - DCFG) >> 2] = val;
+            break;
+        }
+    } else if ((addr >= DIEPCTL(0) && addr < DIEPCTL(DWC2_EP_BLOCKS)) ||
+               (addr >= DOEPCTL(0) && addr < DOEPCTL(DWC2_EP_BLOCKS))) {
+        bool in = addr < DOEPCTL(0);
+        int n = (addr - (in ? DIEPCTL(0) : DOEPCTL(0))) >> 5;
+        uint32_t *ep;
+
+        if (n >= DWC2_NB_EP) {
+            return;
+        }
+        ep = dwc2_ep(s, n, in);
+        switch ((addr >> 2) & 7) {
+        case DEP_CTL:
+            dwc2_epctl_write(s, n, in, val);
+            break;
+        case DEP_INT:
+            ep[DEP_INT] &= ~val;
+            if (in) {
+                ep[DEP_INT] |= DXEPINT_TXFEMP;  /* the FIFO is always empty */
+            }
+            break;
+        case DEP_TSIZ:
+        case DEP_DMA:
+            ep[(addr >> 2) & 7] = val;
+            break;
+        default:
+            break;              /* DTXFSTS, DxEPDMAB: read-only */
+        }
+    }
+    dwc2_device_run(s);
+    dwc2_device_update_irq(s);
+}
+
+/* Controller reset and bus events */
+
+void dwc2_device_reset(DWC2State *s)
+{
+    DWC2GadgetState *g = s->gadget;
+    int n;
+
+    memset(s->dreg, 0, sizeof(s->dreg));
+    memset(s->iepreg, 0, sizeof(s->iepreg));
+    memset(s->oepreg, 0, sizeof(s->oepreg));
+    s->dctl = DCTL_SFTDISCON;
+    s->iepreg[0][DEP_CTL] = DXEPCTL_USBACTEP;
+    s->oepreg[0][DEP_CTL] = DXEPCTL_USBACTEP;
+    for (n = 0; n < DWC2_NB_EP; n++) {
+        s->iepreg[n][DEP_INT] = DXEPINT_TXFEMP;
+        s->iepreg[n][DEP_TXFSTS] = 0x200;
+    }
+    if (g) {
+        g->ctrl_phase = DWC2_CTRL_IDLE;
+    }
+    dwc2_session_apply(s, false);
+}
+
+/* The dwc2-gadget USB device */
+
+/*
+ * USB 2.0 7.1.7.5: the host drives reset for at least T_DRST (10 ms), at
+ * the end of which the core has negotiated the speed (EnumDone), and then
+ * allows T_RSTRCY (10 ms) of recovery before its first SETUP.
+ */
+#define DWC2_T_DRST_NS      (10 * SCALE_MS)
+#define DWC2_T_RSTRCY_NS    (10 * SCALE_MS)
+
+static void dwc2_gadget_reset_timer(void *opaque)
+{
+    DWC2GadgetState *g = opaque;
+    USBDevice *dev = USB_DEVICE(g);
+    DWC2State *s = g->dwc2;
+
+    if (!s || s->gadget != g) {
+        return;
+    }
+    if (g->reset_phase == 1) {
+        set_field(&s->dsts, dev->speed == USB_SPEED_HIGH ? DSTS_ENUMSPD_HS :
+                                                           DSTS_ENUMSPD_FS,
+                  DSTS_ENUMSPD);
+        dwc2_set_gintsts(s, GINTSTS_ENUMDONE, true);
+        g->reset_phase = 2;
+        timer_mod(g->reset_timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + DWC2_T_RSTRCY_NS);
+    } else {
+        g->reset_phase = 0;
+        dwc2_device_run(s);
+    }
+}
+
+static void dwc2_gadget_handle_reset(USBDevice *dev)
+{
+    DWC2GadgetState *g = DWC2_GADGET(dev);
+    DWC2State *s = g->dwc2;
+
+    if (!s || s->gadget != g) {
+        return;
+    }
+    g->ctrl_p = NULL;
+    g->ctrl_phase = DWC2_CTRL_IDLE;
+    memset(g->in_p, 0, sizeof(g->in_p));
+    memset(g->out_p, 0, sizeof(g->out_p));
+    trace_usb_dwc2_gadget_bus_reset(dev->speed);
+    if (s->dsts & DSTS_SUSPSTS) {
+        /* reset signalling on a suspended bus wakes the core */
+        s->dsts &= ~DSTS_SUSPSTS;
+        dwc2_set_gintsts(s, GINTSTS_WKUPINT, true);
+    }
+    dwc2_set_gintsts(s, GINTSTS_USBRST, true);
+    g->reset_phase = 1;
+    timer_mod(g->reset_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + DWC2_T_DRST_NS);
+}
+
+static void dwc2_gadget_handle_control(USBDevice *dev, USBPacket *p,
+                                       int request, int value, int index,
+                                       int length, uint8_t *data)
+{
+    DWC2GadgetState *g = DWC2_GADGET(dev);
+
+    if (g->ctrl_p) {
+        /* a new SETUP supersedes a control transfer still in progress */
+        dwc2_ctrl_complete(g, USB_RET_IOERROR);
+    }
+    g->ctrl_p = p;
+    g->ctrl_len = length;
+    g->ctrl_done = 0;
+    g->ctrl_phase = DWC2_CTRL_SETUP;
+    p->status = USB_RET_ASYNC;
+    dwc2_device_run(g->dwc2);
+}
+
+/*
+ * Isochronous endpoints move one packet per (micro)frame and never wait: a
+ * frame the guest has not armed for carries nothing.
+ */
+static void dwc2_gadget_handle_iso(DWC2GadgetState *g, USBPacket *p, int n,
+                                   bool in)
+{
+    DWC2State *s = g->dwc2;
+    g_autofree uint8_t *buf = g_malloc(MAX(p->iov.size, 1));
+    bool done, babble;
+    uint32_t moved;
+
+    if (in) {
+        moved = dwc2_ep_in_packets(s, n, buf, p->iov.size, &done, &babble);
+        usb_packet_copy(p, buf, moved);
+        p->status = moved || done ? USB_RET_SUCCESS : USB_RET_NAK;
+    } else {
+        iov_to_buf(p->iov.iov, p->iov.niov, 0, buf, p->iov.size);
+        moved = dwc2_ep_out_packets(s, n, buf, p->iov.size, 0, &done);
+        p->actual_length = moved;
+        p->status = done ? USB_RET_SUCCESS : USB_RET_NAK;
+    }
+    dwc2_device_update_irq(s);
+}
+
+static void dwc2_gadget_handle_data(USBDevice *dev, USBPacket *p)
+{
+    DWC2GadgetState *g = DWC2_GADGET(dev);
+    DWC2State *s = g->dwc2;
+    int n = p->ep->nr;
+    bool in = p->pid == USB_TOKEN_IN;
+    uint32_t ctl;
+    bool done;
+
+    if (n >= DWC2_NB_EP) {
+        p->status = USB_RET_STALL;
+        return;
+    }
+    ctl = dwc2_ep(s, n, in)[DEP_CTL];
+    /* an endpoint the guest has not activated does not answer: stall */
+    if (!(ctl & DXEPCTL_USBACTEP) || (ctl & DXEPCTL_STALL)) {
+        p->status = USB_RET_STALL;
+        return;
+    }
+    if ((ctl & DXEPCTL_EPTYPE_MASK) == DXEPCTL_EPTYPE_ISO) {
+        dwc2_gadget_handle_iso(g, p, n, in);
+        return;
+    }
+
+    p->status = USB_RET_SUCCESS;
+    if (in) {
+        g->in_p[n] = p;
+        done = dwc2_ep_in_run(g, n);
+    } else {
+        g->out_p[n] = p;
+        g->out_off[n] = 0;
+        done = dwc2_ep_out_run(g, n);
+    }
+    dwc2_device_update_irq(s);
+    if (done) {
+        /* finished at once: answer synchronously */
+        if (in) {
+            g->in_p[n] = NULL;
+        } else {
+            g->out_p[n] = NULL;
+        }
+        return;
+    }
+    p->status = USB_RET_ASYNC;
+}
+
+static void dwc2_gadget_cancel_packet(USBDevice *dev, USBPacket *p)
+{
+    DWC2GadgetState *g = DWC2_GADGET(dev);
+    int n;
+
+    if (g->ctrl_p == p) {
+        g->ctrl_p = NULL;
+        g->ctrl_phase = DWC2_CTRL_IDLE;
+    }
+    for (n = 0; n < DWC2_NB_EP; n++) {
+        if (g->in_p[n] == p) {
+            g->in_p[n] = NULL;
+        }
+        if (g->out_p[n] == p) {
+            g->out_p[n] = NULL;
+        }
+    }
+}
+
+/* The port's VBUS: whether a host is connected. */
+static void dwc2_gadget_vbus_changed(USBDevice *dev)
+{
+    DWC2GadgetState *g = DWC2_GADGET(dev);
+
+    if (g->dwc2 && g->dwc2->gadget == g) {
+        trace_usb_dwc2_gadget_vbus(usb_port_vbus(dev->port));
+        dwc2_device_update_session(g->dwc2);
+    }
+}
+
+static void dwc2_gadget_realize(USBDevice *dev, Error **errp)
+{
+    DWC2GadgetState *g = DWC2_GADGET(dev);
+
+    if (!g->dwc2) {
+        bool ambiguous = false;
+        Object *o = object_resolve_path_type("", TYPE_DWC2_USB, &ambiguous);
+
+        if (!o || ambiguous) {
+            error_setg(errp, "dwc2-gadget: %s DWC2 controller in the "
+                       "machine; set 'controller'",
+                       ambiguous ? "more than one" : "no");
+            return;
+        }
+        g->dwc2 = DWC2_USB(o);
+    }
+    if (g->dwc2->gadget) {
+        error_setg(errp, "dwc2-gadget: the controller already has a gadget");
+        return;
+    }
+
+    /* attached (visible to the host) only while the guest pulls up */
+    dev->auto_attach = 0;
+    dev->speedmask = USB_SPEED_MASK_FULL | USB_SPEED_MASK_HIGH;
+    /* host-like: interrupt endpoints may answer asynchronously */
+    dev->flags |= 1 << USB_DEV_FLAG_IS_HOST;
+    g->connect_bh = qemu_bh_new(dwc2_gadget_connect_bh, g);
+    g->reset_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                  dwc2_gadget_reset_timer, g);
+    g->dwc2->gadget = g;
+    dwc2_device_update_session(g->dwc2);
+}
+
+static void dwc2_gadget_unrealize(USBDevice *dev)
+{
+    DWC2GadgetState *g = DWC2_GADGET(dev);
+
+    if (g->dwc2 && g->dwc2->gadget == g) {
+        g->dwc2->gadget = NULL;
+        dwc2_device_update_session(g->dwc2);
+    }
+    qemu_bh_delete(g->connect_bh);
+    timer_free(g->reset_timer);
+}
+
+static const Property dwc2_gadget_properties[] = {
+    DEFINE_PROP_LINK("controller", DWC2GadgetState, dwc2, TYPE_DWC2_USB,
+                     DWC2State *),
+};
+
+static const VMStateDescription vmstate_dwc2_gadget = {
+    .name = "dwc2-gadget",
+    .unmigratable = 1,          /* host packets in flight are not migrated */
+};
+
+static void dwc2_gadget_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    USBDeviceClass *uc = USB_DEVICE_CLASS(klass);
+
+    uc->realize = dwc2_gadget_realize;
+    uc->unrealize = dwc2_gadget_unrealize;
+    uc->product_desc = "DWC2 USB gadget";
+    uc->handle_reset = dwc2_gadget_handle_reset;
+    uc->handle_control = dwc2_gadget_handle_control;
+    uc->handle_data = dwc2_gadget_handle_data;
+    uc->cancel_packet = dwc2_gadget_cancel_packet;
+    uc->vbus_changed = dwc2_gadget_vbus_changed;
+    dc->desc = "The guest's USB gadget on a DWC2 OTG controller";
+    dc->vmsd = &vmstate_dwc2_gadget;
+    device_class_set_props(dc, dwc2_gadget_properties);
+    set_bit(DEVICE_CATEGORY_USB, dc->categories);
+}
+
+static const TypeInfo dwc2_gadget_info = {
+    .name          = TYPE_DWC2_GADGET,
+    .parent        = TYPE_USB_DEVICE,
+    .instance_size = sizeof(DWC2GadgetState),
+    .class_init    = dwc2_gadget_class_init,
+};
+
+static void dwc2_gadget_register_types(void)
+{
+    type_register_static(&dwc2_gadget_info);
+}
+
+type_init(dwc2_gadget_register_types)
